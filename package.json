{
  "name": "@local/tortoisegit-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AI 回合自动提交与 TortoiseGit 原生窗口桥接",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "tortoisegit",
    "git",
    "auto-commit",
    "factory-droid",
    "codex"
  ],
  "author": "sj1547139223",
  "license": "MIT",
  "homepage": "https://github.com/sj1547139223/TortoiseGitAI#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sj1547139223/TortoiseGitAI.git"
  },
  "bugs": {
    "url": "https://github.com/sj1547139223/TortoiseGitAI/issues"
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.3"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "droid",
    "codex",
    "hooks",
    "mcp.json",
    ".factory-plugin",
    "commands",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js",
    "check": "node --check index.js && node --check client.js && node --check droid/hook.js && node --check droid/mcp.js && node --check droid/cli.js && node --check codex/hook.js && node --check codex/mcp.js && node --check codex/cli.js && node --check codex/summary.js"
  },
  "dependencies": {
    "zod": "^4.0.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
